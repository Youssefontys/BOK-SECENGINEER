# Template voor .env, die zelf niet in git staat (zie .gitignore).
# Kopieer dit bestand naar .env en vul echte waarden in.
#
# Dit zijn lokale ontwikkelwaarden. In Azure komen deze uit Key Vault en
# GitHub Secrets, niet uit een bestand.

# Wachtwoord van de database-eigenaar (superuser in de container). Wordt
# alleen gebruikt voor initialisatie en migraties.
POSTGRES_PASSWORD=

# Wachtwoord van de beperkte applicatierol. Hiermee verbindt de app.
APP_DB_PASSWORD=

# Sleutel waarmee Flask sessiecookies ondertekent. Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Sleutel voor de kolomencryptie van users.totp_secret. Verlies je deze,
# dan zijn bestaande TOTP-secrets niet meer te ontsleutelen en moeten
# gebruikers hun tweede factor opnieuw instellen.
DB_ENCRYPTION_KEY=

# Vault voor lokale notitie-encryptie wordt automatisch door Compose ingericht.
# VAULT_TOKEN is niet nodig: de app krijgt een beperkt token via een read-only volume.
# Buiten Compose: configureer VAULT_ADDR en VAULT_TOKEN_FILE (of VAULT_TOKEN).

# Optioneel. Hoe streng de IP-limieten bij inloggen en registreren zijn:
#   strict    (standaard) streng, met escalatie
#   hackweek  ruimer en korter, voor veel gebruikers achter één adres
#   observe   alleen melden, nooit blokkeren op IP
# De limieten per account zijn in alle standen gelijk.
# THROTTLE_IP_MODE=strict

# Optioneel. Gebruikersnamen (komma-gescheiden) zonder blokkade per account en
# IP, voor het demoaccount in de hacking week. Zie Week 5.md.
# THROTTLE_PAIR_EXEMPT_USERS=hackingweek
