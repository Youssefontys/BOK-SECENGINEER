# Terraform specific
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
.env

# Kept ignored on purpose even though the current backend.*.conf files contain
# no secrets: this is a fail-safe against a future .conf file that does.
*.conf

# Python specific
__pycache__/
*.py[cod]
venv/
.venv/
# Pytest maakt deze map in de container aan; git meldt anders bij elke status
# "Permission denied" en die ruis verbergt echte meldingen.
.pytest_cache/
